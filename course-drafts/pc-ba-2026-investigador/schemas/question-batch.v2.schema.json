{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://detonaconcursos.local/schemas/detona_question_batch_v2.schema.json",
  "title": "DETONA Question Batch Schema v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "batch_id", "contest_id", "position_id", "discipline_id",
    "topic_id", "canonical_scope", "curriculum_node_id", "subtopic_id", "exam_board",
    "question_type", "status", "question_count", "source_catalog_version", "questions", "validation"
  ],
  "properties": {
    "schema_version": { "const": "detona_question_batch_v2" },
    "batch_id": { "$ref": "#/$defs/id" },
    "contest_id": { "$ref": "#/$defs/id" },
    "position_id": { "$ref": "#/$defs/long_id" },
    "discipline_id": { "$ref": "#/$defs/long_id" },
    "topic_id": { "$ref": "#/$defs/long_id" },
    "canonical_scope": { "enum": ["subtopic", "topic"] },
    "curriculum_node_id": { "$ref": "#/$defs/long_id" },
    "subtopic_id": { "type": ["string", "null"], "maxLength": 160 },
    "exam_board": { "const": "instituto_aocp" },
    "question_type": { "const": "multiple_choice" },
    "status": { "enum": ["rascunho_revisar", "revisado_com_pendencias", "validado", "ready_for_bundle"] },
    "question_count": { "const": 20 },
    "source_catalog_version": { "type": "string", "minLength": 1 },
    "questions": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/question" }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewed", "blocking_errors", "warnings", "duplicate_check", "schema_check", "source_check", "microknowledge_check"],
      "properties": {
        "reviewed": { "type": "boolean" },
        "blocking_errors": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "duplicate_check": { "enum": ["pending", "passed", "failed"] },
        "schema_check": { "enum": ["pending", "passed", "failed"] },
        "source_check": { "enum": ["pending", "passed", "failed"] },
        "microknowledge_check": { "enum": ["pending", "passed", "failed"] }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 80 },
    "long_id": { "type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 160 },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id", "sequence", "primary_microknowledge_id", "secondary_microknowledge_ids",
        "pedagogical_role", "competence", "reasoning_type", "statement", "command", "options",
        "correct_option", "difficulty", "explanation", "source_references", "status"
      ],
      "properties": {
        "question_id": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 20 },
        "primary_microknowledge_id": { "$ref": "#/$defs/long_id" },
        "secondary_microknowledge_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/long_id" } },
        "pedagogical_role": { "enum": ["diagnostic", "teaching", "reinforcement", "retention", "discrimination", "integration"] },
        "competence": { "type": "string", "minLength": 3 },
        "reasoning_type": { "enum": ["recognition", "conceptual_understanding", "application", "discrimination", "exception_handling", "case_analysis", "calculation", "interpretation"] },
        "statement": { "type": "string", "minLength": 20 },
        "command": { "type": "string", "minLength": 5 },
        "options": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/option" } },
        "correct_option": { "enum": ["A", "B", "C", "D", "E"] },
        "difficulty": { "enum": ["facil", "intermediaria", "dificil"] },
        "explanation": { "$ref": "#/$defs/explanation" },
        "source_references": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source_reference" } },
        "status": { "enum": ["rascunho_revisar", "revisado_com_pendencias", "validado", "ready_for_bundle"] }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "text"],
      "properties": {
        "label": { "enum": ["A", "B", "C", "D", "E"] },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "correct_option_analysis", "option_analysis", "trap", "added_knowledge", "learning_takeaway"],
      "properties": {
        "summary": { "type": "string", "minLength": 20 },
        "correct_option_analysis": { "type": "string", "minLength": 20 },
        "option_analysis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["A", "B", "C", "D", "E"],
          "properties": {
            "A": { "type": "string", "minLength": 5 },
            "B": { "type": "string", "minLength": 5 },
            "C": { "type": "string", "minLength": 5 },
            "D": { "type": "string", "minLength": 5 },
            "E": { "type": "string", "minLength": 5 }
          }
        },
        "trap": { "type": "string", "minLength": 5 },
        "added_knowledge": { "type": "string", "minLength": 10 },
        "learning_takeaway": { "type": "string", "minLength": 10 }
      }
    },
    "source_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "location", "used_for"],
      "properties": {
        "source_id": { "$ref": "#/$defs/id" },
        "location": { "type": "string", "minLength": 1 },
        "used_for": { "type": "string", "minLength": 1 },
        "verified_at": { "type": "string" }
      }
    }
  }
}
